        "prec = precision_score(labels_test, preds_binary)\n",
        "recall = recall_score(labels_test, preds_binary)\n",
        "f1 = f1_score(labels_test, preds_binary)\n",
        "auc = roc_auc_score(labels_test, preds)\n",
        "\n",
        "print(\"Precision:\", prec)\n",
        "print(\"Recall:\", recall)\n",
        "print(\"F1 score:\", f1)\n",

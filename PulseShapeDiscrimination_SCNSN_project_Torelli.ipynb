        "from tensorflow import keras\n",
        "from tensorflow.keras.callbacks import EarlyStopping, ReduceLROnPlateau\n",
        "from tensorflow.keras.optimizers import Adam\n",
        "\n",
        "model.compile(optimizer=Adam(learning_rate= 0.0001), loss='binary_crossentropy', metrics=['accuracy'])\n",
        "\n",
        "early_stop = keras.callbacks.EarlyStopping(monitor='val_loss', patience=5, verbose = 2, restore_best_weights=True)\n",
        "reduce_lr = keras.callbacks.ReduceLROnPlateau(monitor='val_loss', factor=0.2, patience=2, min_lr=1e-6, verbose=1)\n",
        "\n",
        "history = model.fit(data_train, labels_train,\n",
        "                    validation_data=(data_val, labels_val),\n",
        "                    epochs=13,\n",
        "                    batch_size=64,\n",
        "                    callbacks = [early_stop, reduce_lr])"

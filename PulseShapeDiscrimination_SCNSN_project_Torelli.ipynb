        "    plt.grid(True)\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "plot_roc_curve(fpr2, tpr2)\n",
        "plt.show()\n",
        "\n",
        "auc2 = roc_auc_score(labels_rf_test, scores_photons_test)\n",

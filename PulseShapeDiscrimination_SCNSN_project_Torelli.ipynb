        "%%time\n",
        "from tensorflow.keras.callbacks import EarlyStopping, ReduceLROnPlateau\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import Input, Dense, Conv1D, MaxPooling1D, Flatten, Dropout\n",
        “from tensorflow.keras import backend as K“,
        "\n",
        "dropout_values = [0.0, 0.2, 0.5]\n",
        "n_filters_values = [16,32,64]\n",
        "learning_rate_values=[1e-2, 1e-3, 1e-4]\n",
        "results_gridsearch = np.zeros((len(dropout_values), len(n_filters_values),len(learning_rate_values), 2))\n",
        "\n",
        "reduce_lr = ReduceLROnPlateau(monitor='val_loss', factor=0.2, patience=2, min_lr=1e-6, verbose=0)\n",
        "early_stopping = EarlyStopping(monitor='val_loss', patience=5, verbose=0, restore_best_weights=True)\n",
        "\n",
        "for iDrop, drop in enumerate(dropout_values):\n",
        "  for iN, n_filters in enumerate(n_filters_values):\n",
        "    for iLR, lr in enumerate(learning_rate_values):\n",
        "\n",
        "      K.clear_session()",
        "      model_grid = Sequential([\n",
        "        Input(shape=(512, 1)),\n",
        "        Conv1D(filters=n_filters, kernel_size=3, activation='relu'),\n",
        "        MaxPooling1D(pool_size=2),\n",
        "        Flatten(),\n",
        "        Dropout(drop),\n",
        "        Dense(1, activation='sigmoid')\n",
        "      ])\n",
        "\n",
        "      model_grid.compile(\n",
        "        loss='binary_crossentropy',\n",
        "        optimizer= \"adam\",\n",
        "        metrics=['accuracy'])\n",
        "\n",
        "      history = model_grid.fit(\n",
        "            data_train, labels_train,\n",
        "            validation_data=(data_val, labels_val),\n",
        "            epochs=13,\n",
        "            batch_size=64,\n",
        "            callbacks=[early_stopping, reduce_lr],\n",
        "            verbose=0\n",
        "        )\n",
        "      val_loss, val_acc = model_grid.evaluate(data_val, labels_val, verbose=0)\n",
        "\n",
        "      results_gridsearch[iDrop, iN, iLR, 0] = val_loss\n",
        "      results_gridsearch[iDrop, iN, iLR, 1] = val_acc\n",
        "\n",
        "      t = model_grid.evaluate(data_test, labels_test, verbose=0, batch_size=128)\n",
        "      results_gridsearch[iDrop, iN, iLR] = t\n",
        "      print(f\"dropout = {drop:.2f}, {n_filters} filters, {lr:.4f} LR -> accuracy {results_gridsearch[iDrop, iN, iLR][1]:.4f}, error rate = {100*(1-results_gridsearch[iDrop, iN, iLR][1]):.1f}%\")\n"
      ],
